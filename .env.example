
# ==========================================
# CineMatch ML V2 - Environment Variables
# ==========================================

# Backend FastAPI - TMDb API Read Access Token
# Get your token from https://www.themoviedb.org/settings/api
# Do not put real tokens in this example file.
TMDB_READ_ACCESS_TOKEN=

# Frontend URL allowed by FastAPI CORS
# Local development:
FRONTEND_URL=http://localhost:3000

# Frontend Vite API URL
# Set the deployed Render URL in Vercel Environment Variables.
VITE_API_URL=http://127.0.0.1:8000
